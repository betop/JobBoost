# API Configuration
NEXT_PUBLIC_API_BASE_URL=/api

# --- Xano target (server-side) -------------------------------------------------------------
# Production (Vercel "Production" env): leave XANO_BRANCH / XANO_DATA_SOURCE EMPTY -> live branch.
# Staging (Vercel "Preview" env for git branch "staging"):
#   XANO_BRANCH=staging
#   XANO_DATA_SOURCE=test        # only if a separate Xano test data source exists; otherwise staging shares production DATA
#   NEXT_PUBLIC_SITE_URL=https://<staging-domain>
# A deployment of the git branch "staging" defaults XANO_BRANCH to "staging" even if unset.
XANO_HOST=https://api.shsws-solutions.com
XANO_BRANCH=
XANO_DATA_SOURCE=

# Legacy proxy target (unused by the app; kept for reference). Xano API Base URL example:
# Example: https://xxxxx-xxxxx.xano.io/api:v1
XANO_API_BASE_URL=

# Optional: Configure base URL for different environments
# NEXT_PUBLIC_API_BASE_URL=https://your-production-api.com/api

# Optional: direct browser upload target for extension setup files (bypasses the Vercel 4.5 MB proxy limit)
# NEXT_PUBLIC_XANO_EXTENSION_API_URL=https://api.shsws-solutions.com/api:eqIK8vAt/extensions
